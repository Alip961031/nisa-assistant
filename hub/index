<script>
(function nisaFinalLoginFix(){
  const VALID_USER = 'MINIFID-A';
  const VALID_PASS = 'Aleyp@552489';
  const SESSION_KEY = 'nisa_support_hub_session';

  function byId(id){ return document.getElementById(id); }
  function getLogin(){ return byId('nisaLoginPage'); }
  function getApp(){ return byId('nisaAppShell') || document.body.querySelector(':scope > .flex'); }

  function ensureToast(){
    let toast = byId('nisaLoginToast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'nisaLoginToast';
      toast.className = 'nisa-login-toast';
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');
      document.body.appendChild(toast);
    }
    return toast;
  }

  function notify(message, type){
    const toast = ensureToast();
    toast.className = 'nisa-login-toast ' + (type || '');
    toast.innerHTML = '<i class="fas ' + (type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation') + '"></i><span>' + message + '</span>';
    requestAnimationFrame(() => toast.classList.add('show'));
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => toast.classList.remove('show'), 3200);
  }

  function setError(message){
    const error = byId('nisaLoginError');
    if (error) {
      error.innerHTML = message ? '<i class="fas fa-circle-exclamation"></i><span>' + message + '</span>' : '';
      error.classList.toggle('active', !!message);
    }
    if (message) notify(message, 'error');
  }

  function ensureRememberRow(){
    const form = byId('nisaLoginForm');
    if (!form) return;
    let remember = byId('nisaRememberLogin');
    if (remember) return;

    const row = document.createElement('div');
    row.className = 'nisa-login-row';
    row.innerHTML = '<label><input type="checkbox" id="nisaRememberLogin" checked> Keep me signed in</label>';
    const error = byId('nisaLoginError');
    if (error) form.insertBefore(row, error);
    else form.insertBefore(row, form.querySelector('.nisa-login-btn'));
  }

  function prepareLoginFields(){
    const username = byId('nisaLoginEmail');
    const password = byId('nisaLoginPassword');
    if (username) {
      username.type = 'text';
      username.name = 'username';
      username.placeholder = 'Enter user name';
      username.autocomplete = 'username';
      username.required = true;
    }
    if (password) {
      password.name = 'password';
      password.placeholder = 'Enter password';
      password.autocomplete = 'current-password';
      password.required = true;
    }
  }

  function updateProfile(){
    const profileName = document.querySelector('#profileTrigger p');
    if (profileName) profileName.textContent = VALID_USER;
    const avatar = document.querySelector('#profileTrigger .rounded-full');
    if (avatar) avatar.textContent = 'MA';
    const modeText = byId('modeText');
    if (modeText) modeText.textContent = 'Dev';
    const statusText = byId('statusText');
    if (statusText) statusText.textContent = '0';
    const statusIndicator = byId('statusIndicator');
    if (statusIndicator) statusIndicator.className = 'w-2 h-2 rounded-full bg-gray-400';
    document.body.dataset.nisaUserMode = 'Dev';
    document.body.dataset.nisaUserName = VALID_USER;
    try { if (typeof window.applyNisaSettingsModeAccess === 'function') window.applyNisaSettingsModeAccess(); } catch(e) {}
    try { if (typeof refreshSettingsModeAccess === 'function') refreshSettingsModeAccess(); } catch(e) {}
  }

  function unlockApp(remember){
    const login = getLogin();
    const app = getApp();
    if (app && !app.id) app.id = 'nisaAppShell';

    if (login) {
      login.classList.remove('active');
      login.style.display = 'none';
      login.style.visibility = 'hidden';
      login.style.opacity = '0';
      login.style.zIndex = '';
    }
    if (app) {
      app.classList.remove('nisa-app-locked');
      app.style.display = '';
      app.style.visibility = '';
      app.style.opacity = '';
    }
    document.body.classList.remove('nisa-login-active');
    updateProfile();

    const sessionPayload = JSON.stringify({ user: VALID_USER, mode: 'Dev', remembered: !!remember, ts: Date.now() });
    try {
      if (remember) localStorage.setItem(SESSION_KEY, sessionPayload);
      else sessionStorage.setItem(SESSION_KEY, sessionPayload);
      localStorage.setItem('nisa_login_stability_patch_20260602_seen', '1');
    } catch(e) {}
    setError('');
    const toast = document.getElementById('nisaLoginToast');
    if (toast) toast.classList.remove('show');
  }

  function lockApp(){
    const login = getLogin();
    const app = getApp();
    if (login) login.classList.add('active');
    if (app) app.classList.add('nisa-app-locked');
    document.body.classList.add('nisa-login-active');
  }

  function hasSavedSession(){
    try { return !!(localStorage.getItem(SESSION_KEY) || sessionStorage.getItem(SESSION_KEY)); }
    catch(e) { return false; }
  }

  function handleLogin(e){
    if (e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
    }
    prepareLoginFields();
    ensureRememberRow();

    const username = (byId('nisaLoginEmail')?.value || '').trim();
    const password = byId('nisaLoginPassword')?.value || '';
    const remember = !!byId('nisaRememberLogin')?.checked;

    if (!username || !password) {
      setError('Please enter both user name and password.');
      return false;
    }
    if (username !== VALID_USER || password !== VALID_PASS) {
      setError('Invalid user name or password. Please try again.');
      return false;
    }
    unlockApp(remember);
    return false;
  }

  function bindFinalLogin(){
    prepareLoginFields();
    ensureRememberRow();
    const form = byId('nisaLoginForm');
    const button = form?.querySelector('button[type="submit"], .nisa-login-btn');

    if (form && !form.dataset.nisaFinalLoginFixed) {
      form.dataset.nisaFinalLoginFixed = 'true';
      form.setAttribute('novalidate', 'novalidate');
      form.addEventListener('submit', handleLogin, true);
      form.onsubmit = handleLogin;
    }
    if (button && !button.dataset.nisaFinalLoginFixed) {
      button.dataset.nisaFinalLoginFixed = 'true';
      button.addEventListener('click', function(e){ handleLogin(e); }, true);
    }

    if (hasSavedSession()) unlockApp(true);
    else lockApp();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindFinalLogin);
  } else {
    bindFinalLogin();
  }
  setTimeout(bindFinalLogin, 50);
  setTimeout(bindFinalLogin, 250);
  window.nisaFinalLoginFix = { bind: bindFinalLogin, login: handleLogin };
})();
</script>


