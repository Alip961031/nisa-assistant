    function generateSummaryFromChat(chatHistory, customerName, ticketId, subject) {
        let issue = '', actions = [], resolution = '';
        const customerMsgs = chatHistory.filter(m => m.sender === 'customer').map(m => m.text.toLowerCase());
        const agentMsgs = chatHistory.filter(m => m.sender === 'agent').map(m => m.text);
        if (customerMsgs.some(m => m.includes('refund') || m.includes('damaged'))) issue = 'Customer requested a refund for a damaged item.';
        else if (customerMsgs.some(m => m.includes('log in') || m.includes('password'))) issue = 'Customer was unable to log into their account.';
        else if (customerMsgs.some(m => m.includes('delivered') || m.includes('order'))) issue = 'Customer reported an order not delivered.';
        else issue = `Customer reported: ${customerMsgs[0] || subject}`;
        if (agentMsgs.some(m => m.includes('refund'))) actions.push('Agent initiated refund process.');
        if (agentMsgs.some(m => m.includes('password reset'))) actions.push('Agent sent a manual password reset link.');
        if (agentMsgs.some(m => m.includes('tracking'))) actions.push('Agent provided tracking information.');
        if (agentMsgs.some(m => m.includes('email'))) actions.push('Agent requested and verified customer email.');
        if (actions.length === 0) actions.push('Agent assisted the customer with their issue.');
        const lastCustomerMsg = chatHistory.filter(m => m.sender === 'customer').pop();
        if (lastCustomerMsg && (lastCustomerMsg.text.toLowerCase().includes('thank') || lastCustomerMsg.text.toLowerCase().includes('worked') || lastCustomerMsg.text.toLowerCase().includes('found'))) {
            resolution = 'Customer confirmed issue resolved and expressed satisfaction.';
        } else {
            resolution = 'Issue was resolved through agent assistance.';
        }
        return { issue, actions, resolution };
    }
    
