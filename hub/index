    }
    function mockTranslate(text, targetLang, sourceLang = null) {
        targetLang = normalizeLanguage(targetLang);
        sourceLang = sourceLang ? normalizeLanguage(sourceLang) : detectLanguageFromText(text);
        if (targetLang === 'auto' || sourceLang === 'auto' || targetLang === sourceLang) return text;
        const english = toEnglish(text, sourceLang);
