<script>
    // ========== PROFILE DROPDOWN (unchanged) ==========
    const profileTrigger = document.getElementById('profileTrigger');
    const profileDropdown = document.getElementById('profileDropdown');
    const statusIndicator = document.getElementById('statusIndicator');
    const statusText = document.getElementById('statusText');
    const modeText = document.getElementById('modeText');
    profileTrigger.addEventListener('click', (e) => { e.stopPropagation(); profileDropdown.classList.toggle('hidden'); });
    document.addEventListener('click', (e) => { if (!profileTrigger.contains(e.target) && !profileDropdown.contains(e.target)) profileDropdown.classList.add('hidden'); });
    document.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', (e) => {
            const action = item.getAttribute('data-action');
            if (action === 'status-online') { statusIndicator.className = 'w-2 h-2 rounded-full bg-green-500'; statusText.innerText = 'Online'; if (typeof updateAgentStatus === 'function') updateAgentStatus('jd', 'Online'); showToast('Status changed to Online'); }
            else if (action === 'status-acw') { statusIndicator.className = 'w-2 h-2 rounded-full bg-amber-500'; statusText.innerText = 'Busy'; if (typeof updateAgentStatus === 'function') updateAgentStatus('jd', 'ACW'); showToast('Status changed to Busy'); }
            else if (action === 'status-offline') { statusIndicator.className = 'w-2 h-2 rounded-full bg-gray-400'; statusText.innerText = 'Offline'; if (typeof updateAgentStatus === 'function') updateAgentStatus('jd', 'Offline'); showToast('Status changed to Offline'); }
            else if (action === 'mode-agent') { modeText.innerText = 'Agent'; window.nisaCurrentMode = 'Agent'; showToast('Switched to Agent Mode'); if (typeof renderAIAssistance === 'function') renderAIAssistance(); if (typeof refreshSettingsModeAccess === 'function') refreshSettingsModeAccess(); }
            else if (action === 'mode-admin') { modeText.innerText = 'Admin'; window.nisaCurrentMode = 'Admin'; showToast('Switched to Admin Mode'); if (typeof renderAIAssistance === 'function') renderAIAssistance(); if (typeof refreshSettingsModeAccess === 'function') refreshSettingsModeAccess(); }
            else if (action === 'mode-dev') { modeText.innerText = 'Dev'; window.nisaCurrentMode = 'Dev'; showToast('Switched to Dev Mode'); if (typeof renderAIAssistance === 'function') renderAIAssistance(); if (typeof refreshSettingsModeAccess === 'function') refreshSettingsModeAccess(); }
            profileDropdown.classList.add('hidden');
        });
    });
    
    // ========== PAGE SWITCHING ==========
    const pages = { analytics: document.getElementById('analytics-page'), livechat: document.getElementById('livechat-page'), tickets: document.getElementById('tickets-page'), team: document.getElementById('team-page'), ai: document.getElementById('ai-page'), settings: document.getElementById('settings-page') };
    const sidebarItems = document.querySelectorAll('.sidebar-item');
    const floatingBubble = document.getElementById('floatingBubble');
    const miniMessenger = document.getElementById('miniMessenger');
    function switchPage(pageId) {
        Object.values(pages).forEach(p => p.classList.remove('active-page'));
        pages[pageId].classList.add('active-page');
        sidebarItems.forEach(item => { if (item.getAttribute('data-page') === pageId) item.classList.add('active'); else item.classList.remove('active'); });
        if (pageId === 'livechat') { floatingBubble.style.display = 'none'; miniMessenger.classList.add('hidden'); renderFullscreenConvList(); renderFullscreenChatArea(); setTimeout(applyAllTextareaScrollFixes, 0); renderRightSidebar(); setTimeout(applyAllTextareaScrollFixes, 0); }
        else if (pageId === 'ai') { floatingBubble.style.display = 'none'; miniMessenger.classList.add('hidden'); if (typeof renderAIAssistance === 'function') renderAIAssistance(); setTimeout(applyAllTextareaScrollFixes, 0); }
        else { floatingBubble.style.display = 'flex'; }
        if (pageId === 'analytics' && window.trendChart && window.performanceChart) setTimeout(() => { window.trendChart.resize(); window.performanceChart.resize(); }, 50);
        if (pageId === 'team' && typeof renderTeam === 'function') { renderTeam(); setTimeout(applyAllTextareaScrollFixes, 0); }
        if (pageId === 'tickets') renderTicketsTable();
        if (pageId === 'settings') { hydrateSettingsForm(); bindSettingsPage(); }
    }
    sidebarItems.forEach(item => item.addEventListener('click', () => switchPage(item.getAttribute('data-page'))));
    switchPage('analytics');
    setTimeout(() => applyNisaSettings(loadNisaSettings()), 0);
    

    // ========== SETTINGS PAGE ==========
    const NISA_SETTINGS_KEY = 'nisa_support_hub_settings';
    const NISA_MEMBERS_KEY = 'nisa_support_hub_members';
    const NISA_DEV_NOTES_KEY = 'nisa_support_hub_dev_notes';
    const SETTINGS_MODE_RANK = { Agent: 1, Admin: 2, Dev: 3 };
    function getSettingsMode() { return modeText?.innerText || window.nisaCurrentMode || 'Agent'; }
    function modeAllows(requiredMode) { return (SETTINGS_MODE_RANK[getSettingsMode()] || 1) >= (SETTINGS_MODE_RANK[requiredMode] || 1); }
    function loadNisaSettings() {
        try { return JSON.parse(localStorage.getItem(NISA_SETTINGS_KEY) || '{}'); }
        catch { return {}; }
    }
    function saveNisaSettings(data) { localStorage.setItem(NISA_SETTINGS_KEY, JSON.stringify(data || {})); }
    function getDefaultMembers() {
        return [
            { id:'minifid-a', name:'MINIFID-A', initials:'MA', username:'MINIFID-A', password:'Aleyp@552489', status:'Online', mode:'Dev' }
        ];
    }
    function loadNisaMembers() {
        const onlyMinifid = getDefaultMembers();
        try { localStorage.setItem(NISA_MEMBERS_KEY, JSON.stringify(onlyMinifid)); } catch(e) {}
        return onlyMinifid;
    }
    function saveNisaMembers(members) { localStorage.setItem(NISA_MEMBERS_KEY, JSON.stringify(members || [])); }
    function syncMembersToAgentStatus(members = loadNisaMembers()) {
        if (!Array.isArray(window.agentStatusData) && typeof agentStatusData === 'undefined') return;
        const statusArr = typeof agentStatusData !== 'undefined' ? agentStatusData : window.agentStatusData;
        if (!Array.isArray(statusArr)) return;
        members.forEach(member => {
            let found = statusArr.find(a => a.id === member.id);
            if (!found) {
                statusArr.push({ id: member.id, name: member.name, initials: member.initials || getInitials(member.name), status: member.status || 'Offline', since: new Date() });
            } else {
                found.name = member.name;
                found.initials = member.initials || getInitials(member.name);
                if (found.status !== member.status) { found.status = member.status || 'Offline'; found.since = new Date(); }
            }
        });
        if (typeof renderAgentStatusAnalytics === 'function') renderAgentStatusAnalytics();
    }
    function getInitials(name) { return (name || 'NA').split(/\s+/).filter(Boolean).slice(0,2).map(v => v[0]?.toUpperCase() || '').join('') || 'NA'; }
    function applyNisaSettings(data = loadNisaSettings()) {
        if (data.displayName) {
            const profileName = document.querySelector('#profileTrigger p');
            if (profileName) profileName.innerText = data.displayName;
            const aiProfileName = document.getElementById('aiProfileName');
            if (aiProfileName) aiProfileName.innerText = data.displayName;
        }
        if (data.initials) {
            const avatar = document.querySelector('#profileTrigger .rounded-full');
            if (avatar) avatar.innerText = data.initials;
        }
        if (data.language) ['agentLanguageSelect','miniAgentLanguageSelect'].forEach(id => { const el = document.getElementById(id); if (el) el.value = data.language; });
        document.body.classList.toggle('media-preview-images-off', data.imagePreview === false);
        document.body.classList.toggle('media-preview-videos-off', data.videoPreview === false);
        document.body.classList.toggle('media-preview-audio-off', data.audioPreview === false);
        document.body.classList.toggle('nisa-dark-mode', data.darkMode === true);
        document.querySelectorAll('.fullscreen-ai-hint,.mini-ai-hint,.ai-helper').forEach(el => { el.style.display = data.aiHints === false ? 'none' : ''; });
    }
    function getCurrentModeInfo() {
        const mode = getSettingsMode();
        if (mode === 'Dev') return { icon:'fa-code', label:'Dev Mode', note:'Dev Mode: full access to Agent controls, Admin management, agent mode assignment and advanced controls.' };
        if (mode === 'Admin') return { icon:'fa-shield-alt', label:'Admin Mode', note:'Admin Mode: manage agents, usernames/passwords and status availability. Mode assignment is restricted to Dev.' };
        return { icon:'fa-user-circle', label:'Agent Mode', note:'Agent Mode: simple controls only — profile details, UI/night mode and media controls.' };
    }
    function refreshSettingsModeAccess() {
        const info = getCurrentModeInfo();
        const badge = document.getElementById('settingsCurrentModeBadge');
        if (badge) badge.innerHTML = `<i class="fas ${info.icon}"></i> ${info.label}`;
        const note = document.getElementById('settingsAccessNote');
        if (note) note.innerHTML = `<strong>${info.label}:</strong> ${info.note.replace(/^.*?:\s*/, '')}`;
        const desc = document.getElementById('settingsModeDescription');
        if (desc) desc.innerText = info.note;
        document.querySelectorAll('.settings-tab').forEach(tab => tab.hidden = !modeAllows(tab.dataset.minMode || 'Agent'));
        document.querySelectorAll('.settings-section').forEach(sec => sec.hidden = !modeAllows(sec.dataset.minMode || 'Agent'));
        document.querySelectorAll('.settings-dev-only').forEach(el => el.hidden = getSettingsMode() !== 'Dev');
