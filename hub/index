    async function playNisaNotificationSound(volumeOverride) {
        const data = loadNisaSettings();
        if (data.notificationSound === false && volumeOverride === undefined) return;
        const volume = Math.max(0, Math.min(1, (volumeOverride ?? data.notificationVolume ?? 55) / 100));
        const savedDevices = JSON.parse(localStorage.getItem(NISA_AUDIO_DEVICE_KEY) || '{}');
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return showToast('Audio notification is not supported in this browser');
            const ctx = new AudioContext();
            if (savedDevices.outputDevice && savedDevices.outputDevice !== 'default' && typeof ctx.setSinkId === 'function') {
                try { await ctx.setSinkId(savedDevices.outputDevice); } catch (sinkErr) { console.warn('Output device routing not supported', sinkErr); }
            }
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine'; osc.frequency.value = 880; gain.gain.value = volume * 0.18;
            osc.connect(gain); gain.connect(ctx.destination); osc.start();
            setTimeout(() => { osc.stop(); ctx.close(); }, 160);
        } catch (e) { console.warn('Notification sound failed', e); }
    }
    async function refreshSettingsAudioDevices() {
        const inputSelect = document.getElementById('settingsInputDevice');
        const outputSelect = document.getElementById('settingsOutputDevice');
        if (!inputSelect || !outputSelect) return;
        const saved = JSON.parse(localStorage.getItem(NISA_AUDIO_DEVICE_KEY) || '{}');
        function fill(select, devices, defaultLabel) {
            select.innerHTML = `<option value="default">${defaultLabel}</option>` + devices.map((d, idx) => `<option value="${d.deviceId}">${escapeHtml(d.label || defaultLabel + ' ' + (idx + 1))}</option>`).join('');
        }
        try {
            if (navigator.mediaDevices?.enumerateDevices) {
                const devices = await navigator.mediaDevices.enumerateDevices();
                fill(inputSelect, devices.filter(d => d.kind === 'audioinput'), 'Default microphone');
                fill(outputSelect, devices.filter(d => d.kind === 'audiooutput'), 'Default speaker / headset');
                if (saved.inputDevice) inputSelect.value = saved.inputDevice;
                if (saved.outputDevice) outputSelect.value = saved.outputDevice;
            }
        } catch (e) { showToast('Unable to read audio devices'); }
    }
    function saveSettingsAudioDevices() {
        const inputDevice = document.getElementById('settingsInputDevice')?.value || 'default';
        const outputDevice = document.getElementById('settingsOutputDevice')?.value || 'default';
        localStorage.setItem(NISA_AUDIO_DEVICE_KEY, JSON.stringify({ inputDevice, outputDevice }));
        document.querySelectorAll('audio,video').forEach(media => {
            if (typeof media.setSinkId === 'function' && outputDevice !== 'default') media.setSinkId(outputDevice).catch(()=>{});
        });
    }
