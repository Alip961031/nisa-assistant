/* ===== Settings page ===== */
#settings-page { background: #f9fafb; }
.settings-shell { height: 100%; display: flex; flex-direction: column; min-height: 0; }
.settings-header { flex-shrink: 0; background: #ffffff; border-bottom: 1px solid #e5e7eb; padding: 18px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; box-shadow: 0 1px 2px rgba(15,23,42,0.03); }
.settings-title { display: flex; align-items: center; gap: 12px; }
.settings-icon { width: 42px; height: 42px; border-radius: 14px; background: linear-gradient(135deg,#4f46e5,#7c3aed); color: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 18px rgba(79,70,229,0.22); }
.settings-title h2 { margin: 0; font-size: 22px; font-weight: 900; color: #111827; }
.settings-title p { margin: 3px 0 0; font-size: 12px; color: #64748b; }
.settings-body { flex: 1; min-height: 0; overflow-y: auto; padding: 18px; display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 16px; }
.settings-side, .settings-main-card { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 16px; box-shadow: 0 1px 2px rgba(15,23,42,0.04); }
.settings-side { padding: 10px; align-self: start; position: sticky; top: 0; }
.settings-tab { width: 100%; border: none; background: transparent; border-radius: 12px; padding: 11px 12px; display: flex; align-items: center; gap: 10px; cursor: pointer; color: #475569; font-size: 13px; font-weight: 800; text-align: left; }
.settings-tab:hover { background: #f3f4f6; color: #111827; }
.settings-tab.active { background: #eef2ff; color: #4f46e5; }
.settings-main-card { padding: 18px; }
.settings-section { display: none; }
.settings-section.active { display: block; }
.settings-section-title { font-size: 16px; font-weight: 900; color: #111827; margin-bottom: 4px; }
.settings-section-sub { font-size: 12px; color: #64748b; margin-bottom: 16px; }
.settings-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; }
.settings-field { background: #f8fafc; border: 1px solid #eef2f7; border-radius: 14px; padding: 12px; }
.settings-field label { display: block; font-size: 10px; color: #64748b; font-weight: 900; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 7px; }
.settings-field input, .settings-field select { width: 100%; border: 1px solid #d1d5db; border-radius: 10px; padding: 9px 10px; font-size: 13px; color: #111827; background: #ffffff; outline: none; }
.settings-field input:focus, .settings-field select:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.12); }
.settings-toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid #eef2f7; border-radius: 14px; background: #f8fafc; margin-bottom: 10px; }
.settings-toggle-row strong { display: block; color: #0f172a; font-size: 13px; }
.settings-toggle-row span { display: block; color: #64748b; font-size: 11px; margin-top: 2px; }
.settings-switch { position: relative; width: 44px; height: 24px; flex: 0 0 auto; }
.settings-switch input { opacity: 0; width: 0; height: 0; }
.settings-slider { position: absolute; inset: 0; border-radius: 999px; background: #cbd5e1; cursor: pointer; transition: .16s ease; }
.settings-slider::before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; top: 3px; border-radius: 999px; background: #ffffff; transition: .16s ease; box-shadow: 0 1px 2px rgba(15,23,42,0.2); }
.settings-switch input:checked + .settings-slider { background: #4f46e5; }
.settings-switch input:checked + .settings-slider::before { transform: translateX(20px); }
.settings-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px; }
.settings-btn { border: none; border-radius: 999px; padding: 10px 15px; font-size: 13px; font-weight: 900; cursor: pointer; }
.settings-btn.secondary { background: #f1f5f9; color: #475569; }
.settings-btn.primary { background: #4f46e5; color: #ffffff; box-shadow: 0 8px 16px rgba(79,70,229,0.18); }
.settings-btn.primary:hover { background: #4338ca; }
.settings-btn.secondary:hover { background: #e5e7eb; }
@media (max-width: 900px) { .settings-body { grid-template-columns: 1fr; } .settings-side { position: static; } .settings-grid { grid-template-columns: 1fr; } }



