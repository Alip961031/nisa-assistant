        .agent-translation-note { font-size: 10px; color: #9ca3af; margin-top: 2px; font-style: italic; }
        .language-selector { background: rgba(255,255,255,0.2); border: none; border-radius: 30px; padding: 4px 12px; color: white; font-size: 12px; cursor: pointer; outline: none; }
        .tickets-table-container { overflow-x: auto; }
