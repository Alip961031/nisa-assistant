        if(lower.includes('ticket')||lower.includes('resolved')) return 'I can help search resolved chats, summarize transcripts, compare ticket subjects, prepare export wording, or draft follow-up notes.';
        if(lower.includes('team')||lower.includes('channel')||lower.includes('voice')) return 'I can assist with Team Hub actions: explaining channels, creating a channel/group, summarizing team messages, or preparing escalation notes.';
        if(lower.includes('language')||lower.includes('translate')||lower.includes('malay')||lower.includes('mandarin')||lower.includes('tamil')||lower.includes('hokkien')) return 'I can assist with Malay, English, Hokkien, Mandarin, and Tamil. I can draft replies, translate messages, or suggest the right language mode.';
        if(ctx.mode==='Dev') return `Dev Mode response:\n\nI understand your instruction as: "${q}"\n\nI can turn this into expected behaviour, sample prompts, response rules, UI changes, or validation checks.${notes?'\n\nLoaded training notes:\n'+notes:'\n\nNo saved training notes yet. Use /train to save one.'}`;
