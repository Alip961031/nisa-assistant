    return alt.reply || alt.output || alt.text || res.reply || 'AI assist is unavailable right now.';
  }
  window.nisaHubAiAssist = workerAiAssist;

  document.addEventListener('click', async (e) => {
    const joinButton = e.target.closest('[data-nisa-hub-join]');
    if (joinButton) { e.preventDefault(); await joinCurrentChat(); return; }
    const aiSend = e.target.closest('#aiSendBtn');
    if (aiSend && cfg.ENABLE_AI_BUTTONS) {
      const input = document.getElementById('aiInput');
      const q = (input?.value || '').trim();
      if (!q) return;
      e.preventDefault(); e.stopImmediatePropagation();
      try { if (typeof addAIMessage === 'function') addAIMessage('user', q); } catch(_) {}
      if (input) input.value='';
      const reply = await workerAiAssist(q, 'dashboard_chat');
      try { if (typeof addAIMessage === 'function') addAIMessage('assistant', reply); else safeToast(reply); } catch(_) { safeToast(reply); }
    }
  }, true);

  function addCloudflareButtons() {
    const header = document.querySelector('.fullscreen-chat-header .flex') || document.querySelector('.fullscreen-chat-header');
    if (header && !document.getElementById('nisaHubJoinBtn')) {
      const btn = document.createElement('button');
      btn.id = 'nisaHubJoinBtn';
      btn.setAttribute('data-nisa-hub-join', '1');
      btn.className = 'transfer-chat-btn';
      btn.innerHTML = '<i class="fas fa-cloud"></i> Join Cloudflare';
      header.appendChild(btn);
    }
  }

  async function init() {
    addCloudflareButtons();
    setHubStatus(false, 'Connecting Cloudflare...');
    const diag = await hubRequest('hub_diagnostic', {}, 10000);
    state.lastDiagnostic = diag;
    if (diag.ok) setHubStatus(true, 'Cloudflare connected'); else setHubStatus(false, diag.reply || 'Cloudflare offline');
    if (cfg.AUTO_INIT_TABLES) await hubRequest('init_hub_tables', {}, 20000);
    await refreshTicketsAnalyticsSettings();
    await refreshLiveChatQueue();
    if (state.queueTimer) clearInterval(state.queueTimer);
    state.queueTimer = setInterval(refreshLiveChatQueue, Number(cfg.POLL_LIVECHAT_MS || 4000));
  }
  window.nisaHubInit = init;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else setTimeout(init, 0);
})();
</script>

</body>
</html>
