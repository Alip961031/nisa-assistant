<script>
/* ======================================================================
   NISA Support HUB <-> Cloudflare Worker bridge
   Adds real Worker support to the existing dashboard without removing UI.
   Powered by DeepSeek AI and Cloudflare.
   ====================================================================== */
(function nisaSupportHubCloudflareBridge(){
  const fallbackConfig = {
    WORKER_URL: "https://nisa-deepseek-proxy.kgurun88.workers.dev",
    POLL_LIVECHAT_MS: 4000,
    AUTO_INIT_TABLES: true,
    DEFAULT_AGENT_ID: "minifid-a",
    DEFAULT_AGENT_NAME: "MINIFID-A",
    DEFAULT_AGENT_LANGUAGE: "English",
    ENABLE_WORKER_BRIDGE: true,
    ENABLE_AI_BUTTONS: true,
    ENABLE_LIVECHAT_POLLING: true,
    ENABLE_DASHBOARD_BOOTSTRAP: true
  };
  const cfg = Object.assign({}, fallbackConfig, window.NISA_HUB_CONFIG || {});
  if (!cfg.ENABLE_WORKER_BRIDGE) return;
  const state = { online:false, lastDiagnostic:null, lastQueueAt:0, queueTimer:null, busy:false };
  const safeToast = (msg) => { try { if (typeof showToast === 'function') showToast(msg); else console.log('[NISA HUB]', msg); } catch (_) { console.log('[NISA HUB]', msg); } };
  const getAgentId = () => String(localStorage.getItem('nisa_hub_agent_id') || cfg.DEFAULT_AGENT_ID || 'agent').trim();
  const getAgentName = () => String(localStorage.getItem('nisa_hub_agent_name') || document.getElementById('profileName')?.innerText || cfg.DEFAULT_AGENT_NAME || 'Agent').trim();
  const getAgentLanguage = () => String(document.getElementById('agentLanguageSelect')?.value || cfg.DEFAULT_AGENT_LANGUAGE || 'English').trim();
  const nowTime = (value) => { try { return new Date(value || Date.now()).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); } catch(_) { return new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); } };
  const initials = (name) => String(name || 'CU').split(/\s+/).filter(Boolean).slice(0,2).map(x=>x[0]).join('').toUpperCase() || 'CU';
  const esc = (v) => { try { return typeof escapeHtml === 'function' ? escapeHtml(v) : String(v ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); } catch(_) { return String(v ?? ''); } };

  async function hubRequest(action, payload = {}, timeoutMs = 15000) {
    if (!cfg.WORKER_URL) throw new Error('NISA_HUB_CONFIG.WORKER_URL is missing');
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const body = Object.assign({ action, dashboard:true, source:'nisa_support_hub_dashboard' }, payload || {});
      const res = await fetch(cfg.WORKER_URL, {
        method:'POST',
        signal: controller.signal,
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify(body)
      });
      clearTimeout(timer);
      let data = null;
      try { data = await res.json(); } catch (_) { data = { ok:false, reply: await res.text() }; }
      if (!res.ok) throw new Error(data?.reply || data?.error || ('Worker HTTP ' + res.status));
      return data || {};
    } catch (error) {
      clearTimeout(timer);
      console.warn('NISA HUB Worker request failed:', action, error);
      return { ok:false, reply:String(error && error.message || error), action };
    }
  }
  window.nisaHubRequest = hubRequest;
  window.nisaHubCloudflareBridge = state;

  function setHubStatus(ok, text) {
    state.online = !!ok;
    let badge = document.getElementById('nisaHubCloudflareStatus');
    if (!badge) {
      const header = document.querySelector('aside .p-6') || document.querySelector('aside') || document.body;
      badge = document.createElement('div');
      badge.id = 'nisaHubCloudflareStatus';
      badge.style.cssText = 'margin-top:10px;display:inline-flex;align-items:center;gap:7px;border-radius:999px;padding:6px 10px;font-size:11px;font-weight:800;background:#eef2ff;color:#4f46e5;border:1px solid #e0e7ff;';
      header.appendChild(badge);
    }
    badge.innerHTML = `<span style="width:8px;height:8px;border-radius:999px;background:${ok ? '#10b981' : '#ef4444'};display:inline-block"></span>${esc(text || (ok ? 'Cloudflare connected' : 'Cloudflare offline'))}`;
  }

  function hubAttachmentFromMessage(msg) {
    const url = msg.attachmentUrl || msg.attachment_url || msg.url || '';
    if (!url) return [];
    const name = msg.fileName || msg.filename || 'attachment';
    const type = msg.mimeType || msg.contentType || '';
    let kind = 'file';
    if (/image\//i.test(type) || /\.(png|jpe?g|gif|webp|svg)$/i.test(url)) kind = 'image';
    else if (/video\//i.test(type) || /\.(mp4|mov|webm|mkv)$/i.test(url)) kind = 'video';
    else if (/audio\//i.test(type) || /\.(mp3|wav|m4a|aac|ogg)$/i.test(url)) kind = 'audio';
    return [{ id: msg.id || url, name, type, size: msg.sizeBytes || 0, kind, url }];
  }

  function mapHubMessage(msg) {
    const rawSender = String(msg.sender || msg.senderRole || msg.from || '').toLowerCase();
    const sender = rawSender.includes('agent') ? 'agent' : rawSender.includes('system') ? 'system' : rawSender.includes('assistant') ? 'agent' : 'customer';
    const text = String(msg.text || msg.message || msg.message_text || msg.translatedText || msg.originalText || '').trim();
    return {
      sender,
      text,
      time: nowTime(msg.createdAt || msg.created_at || msg.timestamp),
      isSystem: sender === 'system' || msg.messageType === 'system',
      sourceLang: msg.language || msg.sourceLanguage || 'auto',
      translatedText: msg.translatedText || msg.translated_text || '',
      originalText: msg.originalText || msg.original_text || '',
      attachments: hubAttachmentFromMessage(msg),
      _hubId: msg.id || msg.messageId || `${sender}:${text}:${msg.createdAt || ''}`
    };
  }

  function mapConversation(chat, detail) {
    const id = chat.chatId || chat.liveChatId;
    if (!id) return null;
    const customer = detail?.customer || chat.customer || {};
    const name = customer.name || chat.customerName || chat.name || 'Customer';
    const phone = customer.phone || chat.customerPhone || chat.phone || '';
    const lang = customer.language || chat.customerLanguage || 'Auto';
    const messages = Array.isArray(detail?.messages) ? detail.messages.map(mapHubMessage) : [];
    const latestCustomer = [...messages].reverse().find(m => m.sender === 'customer');
    return {
      id,
      name,
      avatar: initials(name),
      status: chat.status || detail?.status || 'waiting',
      customerLanguage: lang,
      lastMerchantLanguage: lang,
      agentPreferredLang: getAgentLanguage() || 'auto',
      lastMsgTime: new Date(chat.updatedAt || detail?.updatedAt || Date.now()),
      lastMerchantMsgTime: latestCustomer ? new Date(chat.updatedAt || Date.now()) : new Date(chat.createdAt || Date.now()),
      messages,
      hubChatId: id,
      hubStatus: chat.status || detail?.status || 'waiting',
      latestMessage: chat.latestMessage || '',
      source: 'cloudflare'
    };
  }

  function renderHubRefresh() {
    try { if (typeof renderFullscreenConvList === 'function') renderFullscreenConvList(); } catch(e) {}
    try { if (typeof renderFullscreenChatArea === 'function') renderFullscreenChatArea(); } catch(e) {}
    try { if (typeof renderRightSidebar === 'function') renderRightSidebar(); } catch(e) {}
    try { if (typeof renderMiniConvList === 'function') renderMiniConvList(); } catch(e) {}
    try { if (typeof renderMiniMessages === 'function') renderMiniMessages(); } catch(e) {}
    try { if (typeof updateGlobalUnreadBadge === 'function') updateGlobalUnreadBadge(); } catch(e) {}
  }

  async function refreshLiveChatQueue() {
    if (state.busy || !cfg.ENABLE_LIVECHAT_POLLING) return;
    state.busy = true;
    try {
      const queue = await hubRequest('get_live_chat_queue', { agentId:getAgentId(), agentName:getAgentName() }, 12000);
      if (!queue.ok) { setHubStatus(false, queue.reply || 'Cloudflare queue unavailable'); return; }
      setHubStatus(true, `Cloudflare connected · ${Array.isArray(queue.chats) ? queue.chats.length : 0} chats`);
      const chats = Array.isArray(queue.chats) ? queue.chats : [];
      const keep = new Set();
      for (const chat of chats) {
        const chatId = chat.chatId || chat.liveChatId;
        if (!chatId) continue;
        keep.add(chatId);
        let detail = await hubRequest('get_live_chat_messages', { chatId, agentId:getAgentId(), agentName:getAgentName(), agentLanguage:getAgentLanguage() }, 12000);
        if (!detail.ok) detail = { messages:[] };
        const conv = mapConversation(chat, detail);
        if (!conv) continue;
        conversations[chatId] = conv;
        customerDetails[chatId] = Object.assign(customerDetails[chatId] || {}, {
          name: conv.name,
          phone: (detail.customer && detail.customer.phone) || chat.customerPhone || '',
          language: conv.customerLanguage,
          issue: chat.latestMessage || conv.messages.find(m => m.sender === 'customer')?.text || 'Live Chat request',
          sentiment: conv.hubStatus === 'waiting' ? 'Waiting' : 'Active',
          ticketId: chatId,
          source: 'Cloudflare Live Chat'
        });
      }
      if ((!currentCustomerId || !conversations[currentCustomerId]) && chats.length) currentCustomerId = chats[0].chatId || chats[0].liveChatId;
      renderHubRefresh();
      state.lastQueueAt = Date.now();
    } finally { state.busy = false; }
  }
  window.nisaHubRefreshLiveChats = refreshLiveChatQueue;

  const originalSendMessage = (typeof sendMessage === 'function') ? sendMessage : null;
  try {
    sendMessage = async function nisaHubSendMessage(customerId, text, isMini=false) {
      const conv = conversations[customerId];
      if (!conv || !conv.hubChatId) {
        if (originalSendMessage) return originalSendMessage(customerId, text, isMini);
        return;
      }
      const context = isMini ? 'mini' : 'fullscreen';
      let attachments = [];
      try { attachments = typeof takePendingAttachments === 'function' ? takePendingAttachments(context) : []; } catch (_) {}
      text = String(text || '').trim();
      if (!text && !attachments.length) return;
      const inp = document.getElementById(isMini ? 'miniChatInput' : 'fullscreenChatInput');
      if (inp) { inp.value=''; inp.style.height = isMini ? '38px' : '44px'; }
      addMessage(customerId, 'agent', text || '[Attachment]', false, { sourceLang:getAgentLanguage(), attachments });
      const firstAttachmentUrl = attachments[0]?.downloadUrl || attachments[0]?.url || '';
      const res = await hubRequest('send_agent_message', {
        chatId: conv.hubChatId,
        message: text,
        attachmentUrl: firstAttachmentUrl,
        agentId: getAgentId(),
        agentName: getAgentName(),
        agentLanguage: getAgentLanguage()
      }, 15000);
      if (!res.ok) safeToast(res.reply || 'Cloudflare send failed');
      await refreshLiveChatQueue();
    };
  } catch (e) { console.warn('Unable to override sendMessage', e); }

  async function joinCurrentChat() {
    const conv = conversations[currentCustomerId];
    if (!conv?.hubChatId) return;
    const res = await hubRequest('agent_join_chat', { chatId:conv.hubChatId, agentId:getAgentId(), agentName:getAgentName(), agentLanguage:getAgentLanguage() }, 12000);
    if (res.ok) safeToast('Joined Cloudflare Live Chat'); else safeToast(res.reply || 'Unable to join chat');
