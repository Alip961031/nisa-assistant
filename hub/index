/* ===== Preferred language dropdown repair: full live chat + mini chat ===== */
(function setupPreferredLanguageDropdownRepair(){
  const labels = { auto:'Auto', ms:'Malay', en:'English', hokkien:'Hokkien', zh:'Mandarin', ta:'Tamil' };
  function closeAll(except){
    document.querySelectorAll('.live-language-custom-select.open').forEach(el => {
      if (el !== except) {
        el.classList.remove('open');
        el.querySelector('.live-language-trigger')?.setAttribute('aria-expanded','false');
      }
    });
  }
  function build(select){
    if (!select) return;
    const wrap = select.closest('.agent-language-wrap') || select.closest('.mini-tools-row') || select.parentElement;
    if (!wrap) return;
    wrap.querySelectorAll('.live-language-custom-select').forEach(el => el.remove());
    const custom = document.createElement('div');
    custom.className = 'live-language-custom-select';
    custom.dataset.forSelect = select.id || 'language';
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'live-language-trigger';
    trigger.setAttribute('aria-haspopup','listbox');
    trigger.setAttribute('aria-expanded','false');
    const menu = document.createElement('div');
    menu.className = 'live-language-menu';
    menu.setAttribute('role','listbox');
    custom.append(trigger, menu);
    wrap.appendChild(custom);
    select.classList.add('language-selector');
    select.style.position = 'absolute';
    select.style.opacity = '0';
    select.style.pointerEvents = 'none';

    function sync(){
      trigger.innerHTML = `<span>${labels[select.value] || labels.auto}</span><i class="fas fa-chevron-down"></i>`;
      menu.innerHTML = '';
      Array.from(select.options).forEach(opt => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'live-language-option' + (opt.value === select.value ? ' active' : '');
        btn.dataset.value = opt.value;
        btn.setAttribute('role','option');
        btn.setAttribute('aria-selected', opt.value === select.value ? 'true' : 'false');
        btn.textContent = labels[opt.value] || opt.textContent;
        btn.addEventListener('click', e => {
          e.preventDefault();
          select.value = opt.value;
          select.dispatchEvent(new Event('change', { bubbles:true }));
          sync();
          custom.classList.remove('open');
          trigger.setAttribute('aria-expanded','false');
        });
        menu.appendChild(btn);
      });
    }
    trigger.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      const open = !custom.classList.contains('open');
      closeAll(custom);
      custom.classList.toggle('open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    select.addEventListener('change', sync);
    sync();
  }
  function init(){
    build(document.getElementById('agentLanguageSelect'));
    build(document.getElementById('miniAgentLanguageSelect'));
  }
  document.addEventListener('click', () => closeAll());
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  new MutationObserver(() => {
    if (document.getElementById('agentLanguageSelect') && !document.querySelector('.agent-language-wrap .live-language-custom-select')) init();
    if (document.getElementById('miniAgentLanguageSelect') && !document.querySelector('.mini-tools-row .live-language-custom-select')) init();
  }).observe(document.documentElement, { childList:true, subtree:true });
})();

</script>

