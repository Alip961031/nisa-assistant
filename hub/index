    function fromEnglish(text, targetLang) {
        targetLang = normalizeLanguage(targetLang);
        if (targetLang === 'en') return text;
        const dict = {
            ms: { 'I': 'saya', 'want': 'nak', 'refund': 'pemulangan wang', 'damaged': 'rosak', 'help': 'bantuan', 'order': 'pesanan', 'email': 'e-mel', 'confirm': 'sahkan', 'sorry': 'maaf', 'start': 'mulakan', 'process': 'proses', 'photos': 'gambar', 'thank you': 'terima kasih', 'please': 'sila' },
            hokkien: { 'I': 'wa', 'you': 'lu', 'want': 'beh', 'refund': 'refund', 'damaged': 'phaiⁿ', 'help': 'pang chhu', 'order': 'order', 'email': 'email', 'confirm': 'confirm', 'sorry': 'pai seh', 'start': 'khi thau', 'process': 'process', 'photos': 'sio-phinn', 'thank you': 'kam sia', 'please': 'chia' },
            zh: { 'refund': '退款', 'damaged': '损坏', 'help': '帮助', 'order': '订单', 'email': '电子邮件', 'confirm': '确认', 'sorry': '抱歉', 'start': '开始', 'process': '处理', 'photos': '照片', 'thank you': '谢谢', 'please': '请' },
            ta: { 'refund': 'பணத்தைத் திரும்பப் பெறுதல்', 'damaged': 'சேதமடைந்தது', 'help': 'உதவி', 'order': 'ஆர்டர்', 'email': 'மின்னஞ்சல்', 'confirm': 'உறுதிப்படுத்து', 'sorry': 'மன்னிக்கவும்', 'start': 'தொடங்கு', 'process': 'செயல்முறை', 'photos': 'புகைப்படங்கள்', 'thank you': 'நன்றி', 'please': 'தயவுசெய்து' }
        };
