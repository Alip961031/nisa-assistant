    function buildModeAwareAIReply(input){
        const q=(input||'').trim(); const lower=q.toLowerCase(); const ctx=getHubContextSnapshot(); const notes=localStorage.getItem(NISA_AI_TRAINING_KEY)||'';
        if(lower==='/context'||lower.includes('workspace context')||lower.includes('recognise')||lower.includes('recognize')) return `I recognise the current NISA Support Hub context.\n\nProfile: ${ctx.profileName}\nStatus: ${ctx.status}\nMode: ${ctx.mode}\nActive chats: ${ctx.activeChats}\nSelected customer: ${ctx.activeCustomerName}\nSelected ticket: ${ctx.activeTicket}\nSelected issue: ${ctx.activeCustomerIssue}\n\nI can assist across ${ctx.supportedAreas.join(', ')}. My responses adapt based on Agent, Admin, or Dev Mode.`;
        if(lower==='/mode'||lower.includes('current mode')) return ctx.mode==='Dev'?'You are in Dev Mode. I prioritize training behaviour, test prompts, SOP shaping, debugging UI behaviour, and assistant response rules.':ctx.mode==='Admin'?'You are in Admin Mode. I prioritize analytics, team visibility, resolved chats, performance review, and operational oversight.':'You are in Agent Mode. I prioritize live chat support, reply drafting, customer context, translation, summaries, and next-best-action guidance.';
        if(lower.startsWith('/train')||lower.includes('training note')||lower.includes('train it')){if(ctx.mode!=='Dev')return 'Training is available, but switch to Dev Mode first so training notes are treated as priority assistant behaviour.'; const note=q.replace(/^\/train[:\s-]*/i,'').trim(); if(note){localStorage.setItem(NISA_AI_TRAINING_KEY,(notes?notes+'\n':'')+'- '+note); const box=document.getElementById('aiTrainingNotes'); if(box)box.value=localStorage.getItem(NISA_AI_TRAINING_KEY)||''; return 'Training note saved in Dev Mode. I will use it as local guidance for this assistant prototype.'} return `Dev Mode training notes currently loaded:\n${notes||'No training notes saved yet. Use /train followed by your instruction.'}`;}
        if(lower.includes('summar')||lower.includes('summary')) return `Summary based on current workspace context:\n\n${ctx.activeCustomerName!=='None selected'?`${ctx.activeCustomerName} has ticket ${ctx.activeTicket} for: ${ctx.activeCustomerIssue}. Current sentiment: ${ctx.activeSentiment}.`:'No specific customer is selected on the AI Assistance page.'}\n\nMode-aware recommendation (${ctx.mode}): ${ctx.mode==='Admin'?'review volume, assignment, and resolution trend before taking action.':ctx.mode==='Dev'?'convert this into a repeatable training scenario or SOP test case.':'acknowledge the customer, confirm details, then provide a clear next step.'}`;
        if(lower.includes('draft')||lower.includes('reply')||lower.includes('respond')) return `Suggested reply (${ctx.mode}):\n\nHi, thanks for reaching out. I can help check this for you. I can see the current issue is related to ${ctx.activeCustomerIssue}. Let me verify the details and guide you with the next step shortly.`;
