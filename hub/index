    // ========== MEDIA ATTACHMENT PREVIEW HELPERS ==========
    const nisaPendingAttachments = { ai: [], fullscreen: [], mini: [], team: [] };
    function getAttachmentContextFromInput(inpId) {
        if (inpId === 'aiInput') return 'ai';
        if (inpId === 'miniChatInput') return 'mini';
        if (inpId === 'teamMessageInput') return 'team';
        return 'fullscreen';
    }
    function getAttachmentKind(file) {
        const type = (file?.type || '').toLowerCase();
        const name = (file?.name || '').toLowerCase();
        if (type.startsWith('image/') || /\.(png|jpe?g|gif|webp|bmp|svg)$/i.test(name)) return 'image';
        if (type.startsWith('video/') || /\.(mp4|webm|ogg|mov|m4v)$/i.test(name)) return 'video';
        if (type.startsWith('audio/') || /\.(mp3|wav|ogg|m4a|aac|flac)$/i.test(name)) return 'audio';
        return 'file';
    }
    function formatFileSize(bytes) {
        const n = Number(bytes || 0);
        if (n >= 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + ' MB';
        if (n >= 1024) return Math.ceil(n / 1024) + ' KB';
        return n + ' B';
    }
    function createAttachmentObject(file) {
        const kind = getAttachmentKind(file);
        return {
            id: 'att_' + Date.now() + '_' + Math.random().toString(16).slice(2),
            name: file.name || 'attachment',
            type: file.type || 'application/octet-stream',
            size: file.size || 0,
            kind,
            url: URL.createObjectURL(file)
        };
    }
    function renderAttachmentPreviews(attachments = [], options = {}) {
        if (!attachments || !attachments.length) return '';
        const compact = !!options.compact;
        return `<div class="media-attachment-grid">${attachments.map(att => {
            const name = escapeHtml(att.name || 'attachment');
            const meta = `${escapeHtml((att.type || att.kind || 'file').split('/')[0])} · ${formatFileSize(att.size)}`;
            if (att.kind === 'image') {
                return `<div class="media-attachment-card"><img class="media-thumb" src="${att.url}" alt="${name}" onclick="openMediaImageModal('${att.url}')"><div class="media-caption"><i class="fas fa-image"></i><span>${name}</span></div></div>`;
            }
            if (att.kind === 'video') {
                return `<div class="media-attachment-card"><video class="media-video" src="${att.url}" controls preload="metadata"></video><div class="media-caption"><i class="fas fa-video"></i><span>${name}</span></div></div>`;
            }
            if (att.kind === 'audio') {
                return `<div class="media-attachment-card"><div class="media-file-card"><span class="media-file-icon"><i class="fas fa-music"></i></span><div class="media-file-info"><div class="media-file-name">${name}</div><div class="media-file-meta">${meta}</div></div></div><audio class="media-audio" src="${att.url}" controls preload="metadata"></audio></div>`;
            }
            return `<div class="media-attachment-card"><div class="media-file-card"><span class="media-file-icon"><i class="fas fa-file"></i></span><div class="media-file-info"><div class="media-file-name">${name}</div><div class="media-file-meta">${meta}</div></div></div></div>`;
        }).join('')}</div>`;
    }
    function renderPendingAttachmentTray(context) {
        const tray = document.getElementById(`${context}AttachmentPreviewTray`);
        if (!tray) return;
        const list = nisaPendingAttachments[context] || [];
        tray.classList.toggle('active', list.length > 0);
        tray.innerHTML = list.map(att => {
            const name = escapeHtml(att.name || 'attachment');
            let body = '';
            if (att.kind === 'image') body = `<img class="media-thumb" src="${att.url}" alt="${name}" onclick="openMediaImageModal('${att.url}')">`;
            else if (att.kind === 'video') body = `<video class="media-video" src="${att.url}" controls preload="metadata"></video>`;
            else if (att.kind === 'audio') body = `<div class="media-file-card"><span class="media-file-icon"><i class="fas fa-music"></i></span><div class="media-file-info"><div class="media-file-name">${name}</div><div class="media-file-meta">${formatFileSize(att.size)}</div></div></div><audio class="media-audio" src="${att.url}" controls preload="metadata"></audio>`;
            else body = `<div class="media-file-card"><span class="media-file-icon"><i class="fas fa-file"></i></span><div class="media-file-info"><div class="media-file-name">${name}</div><div class="media-file-meta">${formatFileSize(att.size)}</div></div></div>`;
            return `<div class="attachment-draft-card">${body}<button class="attachment-remove-btn" onclick="removePendingAttachment('${context}','${att.id}')"><i class="fas fa-times"></i></button><div class="media-caption"><i class="fas ${att.kind === 'image' ? 'fa-image' : att.kind === 'video' ? 'fa-video' : att.kind === 'audio' ? 'fa-music' : 'fa-file'}"></i><span>${name}</span></div></div>`;
        }).join('');
