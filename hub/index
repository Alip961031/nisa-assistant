    function renderMiniMessages() {
        const conv = conversations[currentCustomerId];
        const container = document.getElementById('miniMessages');
        if (!container) return;
        if (!conv) { container.innerHTML = '<div class="text-center text-gray-400 p-4">No active chat</div>'; return; }
        container.innerHTML = '';
        conv.messages.forEach(msg => {
            const div = document.createElement('div');
            const isSystem = msg.isSystem === true;
            div.className = isSystem ? 'flex justify-center flex-col' : (msg.sender === 'agent' ? 'flex justify-start flex-col' : 'flex justify-end flex-col');
            const bubble = isSystem ? 'chat-bubble-system' : (msg.sender === 'agent' ? 'chat-bubble-agent' : 'chat-bubble-user');
            const color = isSystem ? 'text-gray-500' : (msg.sender === 'agent' ? 'text-gray-800' : 'text-white');
            let extra = '';
            const agentLang = normalizeLanguage(conv.agentPreferredLang || 'auto');
            if (msg.sender === 'customer' && !isSystem && agentLang !== 'auto') {
                const msgLang = normalizeLanguage(msg.sourceLang || detectLanguageFromText(msg.text));
                const tr = mockTranslate(msg.text, agentLang, msgLang);
                if (msgLang !== agentLang && tr !== msg.text) extra = `<div class="translation-shadow">🌐 ${getLanguageName(msgLang)} → ${getLanguageName(agentLang)}: ${escapeHtml(tr)}</div>`;
            }
            if (msg.sender === 'agent' && !isSystem && agentLang !== 'auto') {
                const deliveredLang = normalizeLanguage(msg.deliveredLang || getLatestMerchantLanguage(currentCustomerId));
                const sentText = msg.deliveredText || mockTranslate(msg.text, deliveredLang, msg.sourceLang || agentLang);
                if (deliveredLang !== normalizeLanguage(msg.sourceLang || agentLang)) extra = `<div class="agent-translation-note">📤 Sent in ${getLanguageName(deliveredLang)}: ${escapeHtml(sentText)}</div>`;
            }
            const textHtml = msg.text ? `<p class="text-xs ${color}">${escapeHtml(msg.text)}</p>` : '';
            const attachmentHtml = renderAttachmentPreviews(msg.attachments || [], { compact: true });
            div.innerHTML = `<div class="${bubble} px-3 py-1 max-w-[80%]">${textHtml}${attachmentHtml}<span class="text-[8px] ${msg.sender==='agent'?'text-gray-400':'text-blue-200'} block mt-1">${msg.time}</span></div>${extra}`;
            container.appendChild(div);
        });
        container.scrollTop = container.scrollHeight;
        renderPendingAttachmentTray('mini');
    }
