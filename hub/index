    (function nisaHardFixDarkMode() {
        const SETTINGS_KEY = 'nisa_support_hub_settings';
        const readSettings = () => {
            try { return JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}') || {}; }
            catch { return {}; }
        };
        const writeSettings = (patch) => {
            const data = { ...readSettings(), ...patch };
            localStorage.setItem(SETTINGS_KEY, JSON.stringify(data));
            return data;
        };
        const normalizeBool = (value) => value === true || value === 'true' || value === 1 || value === '1';
        window.nisaSetDarkMode = function(enabled, persist = true) {
            const isOn = normalizeBool(enabled);
            document.documentElement.classList.toggle('nisa-dark-mode', isOn);
            document.body.classList.toggle('nisa-dark-mode', isOn);
            const checkbox = document.getElementById('settingsDarkMode');
            if (checkbox) checkbox.checked = isOn;
            if (persist) writeSettings({ darkMode: isOn });
            try { if (typeof applySettingsBrightness === 'function') applySettingsBrightness(readSettings().brightness ?? 100); } catch (_) {}
            return isOn;
        };
        const applyFromStorage = () => {
            const data = readSettings();
            window.nisaSetDarkMode(normalizeBool(data.darkMode), false);
        };
        const bindToggle = () => {
            const checkbox = document.getElementById('settingsDarkMode');
            if (!checkbox || checkbox.dataset.darkHardFixed === 'true') return;
            checkbox.dataset.darkHardFixed = 'true';
            checkbox.addEventListener('change', () => {
                const data = writeSettings({ darkMode: checkbox.checked });
                window.nisaSetDarkMode(data.darkMode, false);
                try { if (typeof applyNisaSettings === 'function') applyNisaSettings(data); } catch (_) {}
                try { if (typeof showToast === 'function') showToast(checkbox.checked ? 'Dark mode enabled' : 'Dark mode disabled'); } catch (_) {}
            });
        };
        const oldApply = typeof applyNisaSettings === 'function' ? applyNisaSettings : null;
        if (oldApply && !oldApply.__darkHardFixed) {
            applyNisaSettings = function(data = (typeof loadNisaSettings === 'function' ? loadNisaSettings() : readSettings())) {
                const normalized = { ...data, darkMode: normalizeBool(data && data.darkMode) };
                oldApply(normalized);
                window.nisaSetDarkMode(normalized.darkMode, false);
                bindToggle();
            };
            applyNisaSettings.__darkHardFixed = true;
        }
        const oldHydrate = typeof hydrateSettingsForm === 'function' ? hydrateSettingsForm : null;
        if (oldHydrate && !oldHydrate.__darkHardFixed) {
            hydrateSettingsForm = function() {
                oldHydrate();
                applyFromStorage();
                bindToggle();
            };
            hydrateSettingsForm.__darkHardFixed = true;
        }
        document.addEventListener('DOMContentLoaded', () => { applyFromStorage(); bindToggle(); setTimeout(() => { applyFromStorage(); bindToggle(); }, 100); });
        applyFromStorage();
        setTimeout(() => { applyFromStorage(); bindToggle(); }, 50);
    })();







