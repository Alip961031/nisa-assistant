        .empty-chat-state h3 { font-size: 1.25rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem; }
        .empty-chat-state p { color: #6b7280; margin-bottom: 1.5rem; }


        /* ===== Chat layout, responsive UI, language and transfer fixes added by Copilot ===== */
        html, body { height: 100%; height: 100dvh; }
        #livechat-page { min-height: 0; }
        #chatAreaContent { flex: 1; min-height: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden; }
