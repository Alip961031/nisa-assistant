    function stageAttachments(context, files) {
        const arr = Array.from(files || []);
        if (!arr.length) return;
        nisaPendingAttachments[context] = nisaPendingAttachments[context] || [];
        arr.forEach(file => nisaPendingAttachments[context].push(createAttachmentObject(file)));
        renderPendingAttachmentTray(context);
        showToast(`${arr.length} attachment${arr.length > 1 ? 's' : ''} ready to send`);
    }
    function removePendingAttachment(context, id) {
        const list = nisaPendingAttachments[context] || [];
        const found = list.find(a => a.id === id);
        if (found?.url) URL.revokeObjectURL(found.url);
        nisaPendingAttachments[context] = list.filter(a => a.id !== id);
        renderPendingAttachmentTray(context);
    }
