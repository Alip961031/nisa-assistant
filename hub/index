    // Voice and attachment helpers
    function setupVoice(btnId, inpId) {
        const btn = document.getElementById(btnId);
        const inp = document.getElementById(inpId);
        if (!btn) return;
        if ('webkitSpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            const rec = new SpeechRecognition();
            rec.continuous = false; rec.interimResults = false; rec.lang = 'en-US';
            btn.addEventListener('click', () => {
                rec.start();
                btn.classList.add('recording');
                btn.innerHTML = '<i class="fas fa-microphone-slash"></i>';
            });
            rec.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                inp.value += (inp.value ? ' ' : '') + transcript;
                inp.dispatchEvent(new Event('input'));
                btn.classList.remove('recording');
                btn.innerHTML = '<i class="fas fa-microphone"></i>';
            };
            rec.onerror = () => { btn.classList.remove('recording'); btn.innerHTML = '<i class="fas fa-microphone"></i>'; showToast('Voice failed.'); };
            rec.onend = () => { btn.classList.remove('recording'); btn.innerHTML = '<i class="fas fa-microphone"></i>'; };
        } else {
            btn.addEventListener('click', () => showToast('Voice not supported'));
        }
    }
    function setupAttachment(btnId, inpId) {
        const btn = document.getElementById(btnId);
        if (!btn || btn.dataset.mediaAttachBound === 'true') return;
        btn.dataset.mediaAttachBound = 'true';
        const context = getAttachmentContextFromInput(inpId);
        const fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.multiple = true;
        fileInput.accept = 'image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt';
        fileInput.style.display = 'none';
        document.body.appendChild(fileInput);
        btn.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => {
            stageAttachments(context, e.target.files);
            fileInput.value = '';
        });
    }
    
